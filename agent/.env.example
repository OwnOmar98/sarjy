# LiveKit Cloud project
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# STT (primary) + main conversation LLM (primary) — Groq
GROQ_API_KEY=

# Embeddings (primary) + default TTS — Gemini. Also needed as the
# automatic-fallback target for STT/LLM/embeddings below, so required
# even if ElevenLabs is your TTS.
GOOGLE_API_KEY=

# Optional — enables ElevenLabs as primary TTS via tts_adapter.py, with
# Gemini as automatic fallback; without this key, Gemini is the only TTS.
ELEVENLABS_API_KEY=

# Optional but recommended — automatic-fallback target for STT
# (stt_adapter.py), the main LLM (llm_adapter.py), fact-extraction LLM,
# and embeddings (memory.py) if their primary (Groq/Gemini) fails or
# rate-limits. Without this key, those three have no fallback and a
# provider outage degrades to the llm_node graceful-apology path instead.
OPENAI_API_KEY=

# Optional manual overrides — pick which provider is tried first per
# service; the other is still the automatic fallback either way.
# STT_PROVIDER=groq        # or "openai"
# LLM_PROVIDER=groq        # or "openai"
# TTS_PROVIDER=elevenlabs  # or "gemini"

# Memory
DATABASE_URL=
REDIS_URL=
