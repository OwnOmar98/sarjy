# LiveKit Cloud project
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Main conversation LLM (primary) — Groq. Also the STT fallback of last
# resort (stt_adapter.py): lowest measured accuracy of the three configured
# providers, but the only one with no API key requirement beyond this one.
GROQ_API_KEY=

# Embeddings (primary) + default TTS — Gemini. Also needed as the
# automatic-fallback target for LLM/embeddings below, so required even if
# ElevenLabs is your TTS.
GOOGLE_API_KEY=

# STT primary (stt_adapter.py default) + optional ElevenLabs TTS. Without
# this key, STT falls back to whichever of elevenlabs/groq is next in
# STT_PROVIDER's order, and TTS falls back to Gemini.
ELEVENLABS_API_KEY=

# STT primary (stt_adapter.py default, as gpt-transcribe) + automatic-
# fallback target for the main LLM (llm_adapter.py), fact-extraction LLM,
# and embeddings (memory.py) if their primary (Groq/Gemini) fails or
# rate-limits. Recommended even beyond STT: without it those three have no
# fallback and a provider outage degrades to the llm_node graceful-apology
# path instead.
OPENAI_API_KEY=

# Optional manual overrides — pick which provider is tried first per
# service; the others are still automatic fallbacks either way, ordered by
# measured accuracy for STT (see stt_adapter.py's _PROVIDERS).
#
# STT_PROVIDER measured on eval/fixtures (`python eval/stt_compare.py --runs 2`):
#   openai (gpt-transcribe)  mean WER 0.009, code-switched 0.077, p50 1291ms
#   elevenlabs (scribe_v1)   mean WER 0.147, code-switched 0.154, p50  739ms
#   groq (whisper-v3-turbo)  mean WER 0.285, code-switched 0.231, p50  503ms
# openai is markedly the most accurate at roughly double Groq's latency, and
# is now the default; set STT_PROVIDER=groq to trade accuracy back for
# speed. elevenlabs is the only one reporting a real per-utterance confidence.
# STT_PROVIDER=openai      # or "elevenlabs", "groq"
# LLM_PROVIDER=groq        # or "openai"
# TTS_PROVIDER=elevenlabs  # or "gemini"

# Optional — ElevenLabs STT model. scribe_v1 (default) is batch and supports
# keyterms, which is how remembered proper nouns reach the recognizer;
# scribe_v2_realtime streams natively but drops keyterm support.
# ELEVENLABS_STT_MODEL=scribe_v1

# Optional — Whisper hallucination-rejection thresholds (agent/groq_verbose_stt.py).
# STT_AVG_LOGPROB_MIN is OFF by default: measured, it discards real one-word
# confirmations (a genuine "نعم" decodes at -1.004) while rejecting no
# hallucinations. Set it only to re-run `eval/stt_compare.py --sweep`.
# STT_AVG_LOGPROB_MIN=-1.0
# STT_COMPRESSION_RATIO_MAX=2.4
# STT_NO_SPEECH_PROB_MAX=0.6

# Memory
DATABASE_URL=
REDIS_URL=

# Optional — pushes a live-update signal to the web frontend's conversation
# sidebar (web_notify.py) whenever a session starts or its summary finishes,
# so every open tab refreshes instantly instead of on its own next page
# load. Unset is a silent no-op, not a warning — the sidebar's normal
# fetch-on-load path is correct either way, just not instant. Only takes
# effect when the web app is actually running on Cloudflare (event.context.
# cloudflare set — see web/server/api/internal/notify.post.ts); local dev's
# web app under plain `nuxt dev` has nothing to receive this.
# WEB_NOTIFY_URL=https://sarjy-web.owenabuhamour.workers.dev/api/internal/notify
# WEB_NOTIFY_SECRET=
