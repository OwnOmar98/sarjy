NUXT_LIVEKIT_API_KEY=
NUXT_LIVEKIT_API_SECRET=
NUXT_PUBLIC_LIVEKIT_URL=wss://your-project.livekit.cloud
NUXT_DATABASE_URL=

# Shared secret the agent presents when it pushes a live-update signal to
# the conversation sidebar (server/api/internal/notify.post.ts, agent/
# web_notify.py — same value as that WEB_NOTIFY_SECRET). Only checked on
# Cloudflare (event.context.cloudflare set); irrelevant under plain
# `nuxt dev`, and under `wrangler dev` it comes from a local .dev.vars
# file, not this one — see server/routes/ws.ts's own docstring.
NUXT_INTERNAL_NOTIFY_SECRET=
